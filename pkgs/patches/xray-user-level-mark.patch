+// proxy-suite: an outbound whose sockopt.mark carries userLevelMarkFlag marks each socket
+// with the rest of the mark plus the level of the inbound user it dials for, and leaves
+// those of level 0 unmarked: one outbound, and one routing rule, for users the kernel
+// tells apart (their speed limits).
+const userLevelMarkFlag = 0x40000000
+
+func userLevelMark(ctx context.Context, sockopt *SocketConfig) *SocketConfig {
+	if sockopt == nil || sockopt.Mark&userLevelMarkFlag == 0 {
+		return sockopt
+	}
+	var level int32
+	if inbound := session.InboundFromContext(ctx); inbound != nil && inbound.User != nil {
+		level = int32(inbound.User.Level)
+	}
+	marked := proto.Clone(sockopt).(*SocketConfig)
+	if level == 0 {
+		marked.Mark = 0
+	} else {
+		marked.Mark = sockopt.Mark&^userLevelMarkFlag + level
+	}
+	return marked
+}
