+// DetermineTransportCandidate recognizes transport packets before the ranged
+// handshake classifier. A range match by itself is ambiguous, so also require
+// the decrypted receiver index to identify a keypair owned by this device.
+func (device *Device) DetermineTransportCandidate(packet []byte) (uint32, bool) {
+	padding := device.paddings.transport.Load()
+	if len(packet) < int(padding)+MessageTransportSize {
+		return 0, false
+	}
+
+	header := make([]byte, MessageTransportHeaderSize)
+	copy(header, packet[padding:padding+MessageTransportHeaderSize])
+
+	cip, err := device.HeaderProtectionCipher(packet[:HeaderCipherNonceSize])
+	if err != nil {
+		return 0, false
+	}
+	if cip != nil {
+		cip.XORKeyStream(header, header)
+	}
+
+	transportHeader := device.headers.transport.Load()
+	if !transportHeader.Contains(binary.LittleEndian.Uint32(header[:4])) {
+		return 0, false
+	}
+
+	receiver := binary.LittleEndian.Uint32(
+		header[MessageTransportOffsetReceiver:MessageTransportOffsetCounter],
+	)
+	value := device.indexTable.Lookup(receiver)
+	if value.keypair == nil || value.peer == nil {
+		return 0, false
+	}
+
+	return padding, true
+}
